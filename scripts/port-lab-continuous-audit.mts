  await button('审查证据并恢复电子交付').click();await button('连续运行至终点').click();await paused();assert.equal(await seconds(),14400);await notes(12);await button('完成并保存复盘').click();assert.ok((await notebook()).sealedAt);check('lesson12 restored operation reaches the endpoint and saves a report');
