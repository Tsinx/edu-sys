import {mkdir,writeFile,readFile} from 'node:fs/promises';
import {resolve} from 'node:path';
import {PORT_EMERGENCY_HANDBOOK as book} from '../packages/course-content/src/port-emergency-handbook.js';
const root=resolve(import.meta.dirname,'..'),out=resolve(root,'output/port-emergency');await mkdir(out,{recursive:true});
const escape=(s:string)=>s.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
const css=`:root{font-family:'Microsoft YaHei','PingFang SC',sans-serif;color:#214c54;background:#e9eee4;font-synthesis:none}*{box-sizing:border-box}body{margin:0}a{color:#246f79}button{font:inherit;cursor:pointer;background:#235e69;color:#fff8e5;border:0;border-radius:5px;padding:11px 16px}header{padding:22px max(24px,calc((100vw - 1150px)/2));background:#173f4e;color:#fff1d8;display:flex;justify-content:space-between;align-items:center;gap:20px}header strong{display:block;font-size:21px}header small{display:block;margin:7px 0;color:#b9cfc4}header nav{display:flex;gap:12px;align-items:center;flex-wrap:wrap}header a{color:#e0e8d6;font-size:13px}main{max-width:1150px;margin:auto;padding:35px 24px}.title h1{font-size:43px;line-height:1.4;margin:8px 0 10px}.title>p{max-width:850px;line-height:1.9;color:#658073}.title>span{font-size:12px;letter-spacing:2px;color:#a77a40}.toc{display:flex;gap:8px;flex-wrap:wrap;margin:25px 0}.toc a{padding:10px 13px;border:1px solid #b9cdb9;border-radius:5px;background:#f8f8ef;text-decoration:none;font-size:13px}.chapter{padding:35px 40px;margin:26px 0;background:#fbfaf2;border:1px solid #cbd6c0;border-top:5px solid #277d7e;scroll-margin-top:20px}.chapter>span{font-size:13px;color:#a77b43;letter-spacing:2px}.chapter h2{font-size:29px;line-height:1.5;margin:13px 0}.intro{font-size:17px;line-height:1.9;color:#607d72;border-bottom:1px solid #ccd6c0;padding-bottom:23px}h3{font-size:20px;margin:28px 0 13px}p,li{font-size:15px;line-height:1.95}li{padding-left:5px;margin:9px 0}ol{padding-left:23px}.note{border-left:4px solid #b48a4c;background:#eee9d9;padding:15px 19px;font-size:14px}table{border-collapse:collapse;width:100%;font-size:14px;line-height:1.8;table-layout:fixed}th,td{padding:13px 15px;border-bottom:1px solid #ccd6c1;text-align:left;vertical-align:top;overflow-wrap:anywhere}th{background:#214f5b;color:#fbf1dc;font-weight:500}td:first-child{color:#246d72}tbody tr:nth-child(even){background:#edf0e4}.sources{padding:20px;line-height:1.8;font-size:13px}.sources a{display:block;margin:13px 0}footer{padding:25px;text-align:center;font-size:12px;color:#698171}.back{display:inline-block;margin-top:10px;font-size:13px}@media(max-width:650px){header{padding:20px;align-items:start;flex-direction:column}main{padding:25px 13px}.title h1{font-size:32px}.chapter{padding:24px 18px}.chapter h2{font-size:24px}.intro{font-size:16px}th,td{padding:10px 8px;font-size:12px}.toc a{font-size:12px;padding:8px}.note{padding:12px}}@media print{@page{size:A4;margin:15mm}body{background:white;color:#173f4b}header,.title,.toc,.back,footer{display:none}main{padding:0;max-width:none}.chapter{border:0;padding:0;margin:0;break-after:page}.chapter:last-of-type{break-after:auto}.chapter h2{font-size:24px}p,li{font-size:11px;line-height:1.7}h3{font-size:15px;margin:18px 0 10px}th,td{font-size:10px;padding:8px}.intro{font-size:13px}.sources{font-size:10px;padding:0}}`;
const chapters=book.chapters.map((c,i)=>`<section class="chapter" id="${c.id}"><span>${escape(c.kicker)}</span><h2>${escape(c.title)}</h2><p class="intro">${escape(c.intro)}</p>${c.blocks.map(b=>`<article><h3>${escape(b.heading)}</h3>${b.body?`<p>${escape(b.body)}</p>`:''}${b.steps?`<ol>${b.steps.map(s=>`<li>${escape(s)}</li>`).join('')}</ol>`:''}${b.table?`<table><thead><tr>${b.table[0]!.map(s=>`<th>${escape(s)}</th>`).join('')}</tr></thead><tbody>${b.table.slice(1).map(r=>`<tr>${r.map(s=>`<td>${escape(s)}</td>`).join('')}</tr>`).join('')}</tbody></table>`:''}${b.note?`<p class="note">${escape(b.note)}</p>`:''}</article>`).join('')}${i===9?`<div class="sources">${book.sources.map(s=>`<a href="${escape(s.url)}" target="_blank" rel="noopener">${escape(s.label)} ↗</a>`).join('')}</div>`:''}<a class="back" href="#top">返回目录 ↑</a></section>`).join('');
const html=`<!doctype html><html lang="zh-CN"><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${book.title} · ${book.subtitle}</title><style>${css}</style><body><header><div><strong>${book.title}</strong><small>${book.subtitle}</small></div><nav><a href="/port-class-lab.html?lesson=12&mode=teaching">教学模式</a><a href="/port-class-lab.html?lesson=12&mode=practical">实战模式</a><a href="/handouts/port-emergency/port-emergency-student-handbook.pdf" download>下载PDF</a><button onclick="print()">打印手册</button></nav></header><main id="top"><div class="title"><span>港口管理概论 / EMERGENCY FIELD GUIDE</span><h1>${book.title}</h1><p>${book.subtitle} · ${book.version}<br>从异常到可信恢复：取证、隔离、连续性、受控验证、经营复盘和责任交接。</p></div><nav class="toc" aria-label="应急手册目录">${book.chapters.map(c=>`<a href="#${c.id}">${c.kicker}</a>`).join('')}</nav>${chapters}</main><footer>课程教学情境；实际险情按现场预案和授权指挥处置。${book.version}</footer></body></html>`;
await writeFile(resolve(root,'apps/teacher-web/public/port-emergency-handbook.html'),html,'utf8');await writeFile(resolve(out,'handbook.json'),JSON.stringify(book,null,2),'utf8');
let md=`# ${book.title}\n\n${book.subtitle}。${book.version}。\n`;
for(const c of book.chapters){md+=`\n## ${c.kicker} ${c.title}\n\n${c.intro}\n`;for(const b of c.blocks){md+=`\n### ${b.heading}\n\n`;if(b.body)md+=b.body+'\n';if(b.steps)md+=b.steps.map((s,i)=>`${i+1}. ${s}`).join('\n')+'\n';if(b.table)md+='\n| '+b.table[0]!.join(' | ')+' |\n|'+b.table[0]!.map(()=> '---').join('|')+'|\n'+b.table.slice(1).map(r=>'| '+r.join(' | ')+' |').join('\n')+'\n';if(b.note)md+='\n'+b.note+'\n';}}
md+='\n## 参考资料\n\n'+book.sources.map(s=>`- [${s.label}](${s.url})`).join('\n')+'\n';await writeFile(resolve(root,'docs/course/port-management-emergency-student-handbook.md'),md,'utf8');
console.log(JSON.stringify({chapters:book.chapters.length,html:'port-emergency-handbook.html',data:resolve(out,'handbook.json')}));
