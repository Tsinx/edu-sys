import assert from 'node:assert/strict';
import {mkdir,writeFile} from 'node:fs/promises';
import {resolve} from 'node:path';
import {createEnterprise,executeEnterprise,assertEnterprise,enterpriseHash,enterpriseScore,enterpriseRecord,makeEnterprisePackage,verifyEnterprisePackage,depositPrincipal,payableBalance,incidentBudget,type EnterpriseState,type EnterpriseCommand,type EnterpriseConfig} from '../packages/port-simulation-core/src/enterprise.js';
import {enterpriseTeachingSteps,enterpriseIncidentLesson,newEnterpriseTeaching,teachingAllowsCommand} from '../apps/teacher-web/src/features/port-simulation/enterprise/enterprise-teaching.js';
const output=resolve(process.argv[2]??'output/port-enterprise-finance-20261031/audit');await mkdir(output,{recursive:true});const results:unknown[]=[];
function act(s:EnterpriseState,c:EnterpriseCommand){const r=executeEnterprise(s,c,undefined,true);assert.ok(r.journal.at(-1)?.ok,r.journal.at(-1)?.message??'missing result');assertEnterprise(r);return r;}
function advance(s:EnterpriseState,end:number){while(s.hour<end&&s.finance.status!=='bankrupt'&&!s.finance.tutorialPaused){for(const i of s.incidents.filter(i=>i.status!=='resolved'&&(!i.authorization||i.authorizationPaused))){const budget=Math.max(120000,incidentBudget(s,i,'repair'));if(s.cash+depositPrincipal(s)>=budget)s=act(s,{kind:'incident-plan',incidentId:i.id,plan:'repair',budget});}s=act(s,{kind:'advance',hours:Math.min(24*93,end-s.hour),stopOnIncident:true});}return s;}
async function save(name:string,s:EnterpriseState){const preSeal=enterpriseHash(s);s=act(s,{kind:'seal'});const pkg=makeEnterprisePackage(s),checked=verifyEnterprisePackage(pkg);assert.equal(checked.stateHash,enterpriseHash(s));
 const result={name,config:s.config,hour:s.hour,outcome:checked.result.outcome,profit:checked.result.profit,cash:s.cash,deposits:depositPrincipal(s),debt:s.debt,unpaid:payableBalance(s),depositInterest:s.finance.depositInterest,demandInterest:s.finance.demandInterest,loanInterest:s.months.reduce((n,m)=>n+m.interest,0),principalPaid:s.finance.principalPaid,forfeited:s.finance.forfeitedInterest,loans:s.finance.loans.length,months:s.months.length,preSeal,hash:checked.stateHash};results.push(result);await writeFile(resolve(output,name+'-package.json'),JSON.stringify(pkg));await writeFile(resolve(output,'results.json'),JSON.stringify({rules:s.rules,scope:'synthetic local financial simulations; no real grades',results},null,2));console.log(JSON.stringify(result));return result;}
const config:EnterpriseConfig={seed:20261031,years:1,scenario:'balanced',mode:'practice'};
for(const days of [0,30,90] as const){let s=act(createEnterprise(config),{kind:'finance-plan',patch:{reserveDays:30,depositDays:days,creditLimit:0}});s=advance(s,s.horizon);assert.equal(s.finance.status==='bankrupt',false);await save('cash-'+days+'-1y',s);}
let working=act(createEnterprise(config),{kind:'loan',amount:5_000_000,product:'working',termMonths:3});working=advance(working,working.horizon);assert.equal(working.finance.loans.find(l=>l.product==='working')!.balance,0);await save('working-loan-1y',working);
for(const mode of ['none','approved','manual'] as const){let s=createEnterprise(config);if(mode==='approved')s=act(s,{kind:'finance-plan',patch:{reserveDays:30,depositDays:0,creditLimit:5_000_000}});s=act(s,{kind:'project',type:'berth-extension',terminalId:'T1'});s=act(s,{kind:'project',type:'channel-depth',terminalId:'T1'});if(mode==='manual'){s=act(s,{kind:'advance',hours:24,stopOnIncident:false});s=act(s,{kind:'loan',amount:5_000_000,product:'working',termMonths:3});s=act(s,{kind:'settle-payables'});}s=advance(s,s.horizon);if(mode==='none')assert.equal(s.finance.status,'bankrupt');await save('cash-exhaustion-'+mode,s);}
for(const years of [3,5] as const){let s=act(createEnterprise({...config,years}),{kind:'finance-plan',patch:{reserveDays:30,depositDays:years===3?30:90,creditLimit:0}});s=advance(s,s.horizon);assert.equal(s.finance.status==='bankrupt',false);assert.equal(s.debt,0);assert.equal(s.months.length,years*12);await save('long-'+years+'y',s);}
for(const alternate of [false,true]){let s=createEnterprise({seed:20261025,years:3,scenario:'balanced',mode:'practice',tutorial:true});const p=newEnterpriseTeaching();
 const doAct=(c:EnterpriseCommand)=>{assert.ok(teachingAllowsCommand((awaitView)(s),enterpriseRecord(s),p,c));s=act(s,c);};
 const {enterpriseView}=await import('../packages/port-simulation-core/src/enterprise.js');const awaitView=enterpriseView;
 const initial=enterpriseTeachingSteps(enterpriseView(s),enterpriseRecord(s),p);assert.equal(initial.length,38);
 for(let n=0;n<initial.length;n++){const step=enterpriseTeachingSteps(enterpriseView(s),enterpriseRecord(s),p)[n]!;p.selected=step.id;p.starts[step.id]={hour:s.hour,position:s.journal.length};
  if(step.kind==='command')doAct(alternate?step.alternatives?.at(-1)??step.expected!:step.expected!);
  if(step.kind==='advance')while(s.hour<step.planHour!){assert.equal(s.finance.tutorialPaused,false);const incident=enterpriseIncidentLesson(enterpriseView(s));if(incident)doAct(incident.expected);else doAct({kind:'advance',hours:Math.min(24*93,step.planHour!-s.hour),stopOnIncident:true});}
  p.receipts[step.id]={hour:s.hour,position:s.journal.length,evidence:step.evidence};assert.ok(enterpriseTeachingSteps(enterpriseView(s),enterpriseRecord(s),p)[n]!.complete);
 }
 assert.equal(s.hour,4344);assert.equal(enterpriseView(s).finance.guided,false);s=act(s,{kind:'finance-plan',patch:{reserveDays:15,depositDays:90,creditLimit:0}});await save('guided-semester-'+(alternate?'alternative':'default'),s);
}
console.log(JSON.stringify({completed:results.length,output}));
