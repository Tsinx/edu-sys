import {PORT_LESSON_EIGHTEEN_SLIDES as pages,PORT_INVESTMENT_SOURCES,INVESTMENT_STATES,investmentComparisons,investmentFullThreshold,investmentExpansionThreshold,investmentPolicies,expansionTiming} from '../packages/course-content/src/port-expansion.js';
const f=(x:number)=>x.toFixed(2),escape=(s:string)=>s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
let start=0;const timing=expansionTiming(18).map(t=>{const a=start;start+=t.minutes;return `| ${a}—${start}分钟 | ${t.slideStart-727}—${t.slideEnd-727} | ${t.label} |`;}).join('\n');
const teacher='# 第18讲 港口扩建与投资决策\n\n40页，90分钟；第20页后课间。全局第728—767页，1600×1000。\n\n| 时间 | 页码 | 内容 |\n|---|---|---|\n'+timing+'\n\n'+pages.map(p=>`## ${p.localPage}. ${p.title}\n\n${p.lead}\n\n${p.teachingCue}\n\n`+(p.equations?.map((e,i)=>`${i+1}. ${e.tex}：${e.explanation}`).join('\n\n')??'')+(p.reveal?'\n\n参考解析：'+p.reveal:'')+'\n\n来源：'+p.sourceIds?.map(id=>{const s=PORT_INVESTMENT_SOURCES[id as keyof typeof PORT_INVESTMENT_SOURCES];return `[${s.label}](${s.url})，${s.date}`;}).join('；')).join('\n\n');
await writeFile('docs/course/port-management-lesson-eighteen-teacher.md',teacher+'\n');
const model='# 第18讲建设与模型说明\n\n2026-10-26。40页90分钟，保留第1—17讲页码与既有课堂协议。新增轻量模拟使用独立 `port-investment/1.0`，不改写长期经营、48小时实验或旧成绩。\n\n'+
'前45分钟：新增吞吐、增量现金、工期、折现与完整项目门槛。后45分钟：需求情景、固定策略、t1条件追加、等待代价与六年过程模拟。推导页手动展开，学生与投影端不获得教师稿或隐藏解析。\n\n'+
'## 固定时点与边界\n\n资金万元，需求与能力万TEU/年；收费300元/TEU、变动现金成本200元/TEU。既有60万TEU/年业务作为共同基线排除，施工对既有业务的额外影响单列。未计税费、营运资金变化、贷款和通胀；采用统一教学价格口径与给定10%折现率。起始7000万元只是支付能力，不是项目收入；安全储备500为教学约束。\n\n'+
'完整：t0付6000，第1年末施工影响300，第2—6年cap30、固定350，t6净残值1500。一期：t0付3200，第1年末影响180，第2—6年cap15、固定200，净残值800。二期可在t1付3100，第2年影响120，仍仅一期运营，第3—6年cap30、固定400，期末两期残值合计1700。等待若在t1付6000，第2年影响300，第3—6年cap30、固定350，货源保留率80%，期末残值1800。六年是共同观察窗口，残值为独立给定的净处置估计，不是折旧余额，也不表示寿命结束。\n\n'+
'## 信息与评价\n\n基准q=8/18/30，概率25%/50%/25%。t1假设准确辨明第2—6年稳定需求，以解释条件追加。压力模式在第4年合同复核后将q变为6/10/12；第4年过程开始前不向学生公布回落量或使用它给出t1参考NPV。指导中的t1计算只使用需求稳定的当时基准，实际路径NPV在完成后重算。种子只决定可复现的教学状态，不是估计真实概率。\n\n'+
'资金约束检查初始付款与已知第1年施工影响，再检查t1追加后余额。年内收付波动不在此模型中。六年末以相同潜在需求、成本与规则回算五个策略；客户保留率仅作用于等待方案。比较为事后反事实，不是事前可知最优。\n\n'+
'## 数值复核\n\n| 需求 | 完整 | 一期保持 | 一期追加 | 不新增 | 等待后建 |\n|---|---:|---:|---:|---:|---:|\n'+INVESTMENT_STATES.map(v=>'| '+v.q+' | '+investmentComparisons(v.q).map(o=>f(o.npv)).join(' | ')+' |').join('\n')+`\n\n完整零NPV需求门槛${investmentFullThreshold().toFixed(6)}；二期追加门槛${investmentExpansionThreshold().toFixed(6)}万TEU/年。追加门槛在15<q≤30区间求解；额外固定支出200、残值差900、t1付款3100、t2施工影响120。t0一期支出在差额中消去。\n\n`+
Object.entries(investmentPolicies()).map(([k,v])=>'- '+k+'：'+f(v)+'万元').join('\n')+'\n\n灵活性价值是条件策略与最佳固定一期策略的价值差，不再作为现金流入重复加总。期望NPV采用风险中性准则，并与最低现金及情景损失分别展示。\n\n## 交互与保存\n\n模拟顺序：t0说明并锁定初始选择 → 第1年施工与确认 → t1说明并确定后续行动 → 第2—6年逐年经营 → 完整对照与发现。播放、暂停、继续、回到本年起点与直接完成本年读取同一年度模型；动画位置不添加旅行或服务时间。刷新暂停回到最近已完成年度；另开保留已保存比较。独立本机JSON/CSV不伪装为成绩提交，原实验及长期经营入口保留。\n\n## 来源\n\n'+Object.values(PORT_INVESTMENT_SOURCES).map(s=>`- [${s.label}](${s.url})，${s.date}。${s.boundary}`).join('\n')+'\n';
await writeFile('docs/course/port-management-lesson-eighteen-design.md',model);
const handout=`<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>第18讲 · 投资公式与学习手册</title><style>*{box-sizing:border-box}body{margin:0;background:#eef1e8;color:#224b55;font:17px/1.8 "Microsoft YaHei",sans-serif}main{max-width:1080px;margin:28px auto;background:#fffdf4;padding:36px 45px}nav{display:flex;gap:20px;flex-wrap:wrap;font-size:14px}a{color:#267880}h1{font-size:30px}h2{font-size:23px;border-top:1px solid #b3c7b6;padding-top:22px;margin-top:30px}table{border-collapse:collapse;width:100%;font-size:15px;margin:16px 0}th,td{text-align:left;border:1px solid #b9c9b7;padding:9px 12px}th{background:#e5edde}td{height:42px}.scroll{overflow-x:auto}.formula{font-size:20px;padding:14px 20px;border-left:4px solid #b68b50;background:#eff1e5}li{margin:9px 0}footer{font-size:14px;color:#6e8375}@media(max-width:600px){main{margin:0;padding:22px}h1{font-size:25px}table{min-width:640px}}@media print{@page{size:A4;margin:16mm}body{background:white}main{margin:0;padding:0;max-width:none}nav{display:none}h1{font-size:22pt}h2{font-size:16pt;break-after:avoid}p,li{font-size:11pt}table{font-size:9pt;min-width:0;break-inside:avoid}.scroll{overflow:visible}tr{break-inside:avoid}.formula{font-size:12pt}}</style></head><body><main><nav><a href="/port-expansion-preview.html?lesson=18&amp;page=1&amp;student=1">返回课件</a><a href="/port-investment-lab.html">打开分期投资模拟</a><span>Ctrl+P可打印或保存PDF</span></nav><h1>第18讲：港口扩建与投资决策</h1><p>从新增货流走到多年现金，再判断何时投入、何时追加，以及什么条件会改变建议。</p><h2>1. 单位与共同边界</h2><p>需求与能力为万TEU/年，资金为万元。收费300元/TEU，变动现金支出200元/TEU。实际处理x=min(可争取需求q，已投产新增能力K)；年度经营净现金为100x−新增年度固定支出。既有业务保持为共同基线。施工一年，下一年才形成能力。六年为比较窗口，末年加给定净残值。</p><p>本题未计税费、营运资金变化、贷款和通胀。起始资金7000、安全储备500、折现率10%均为教学设定；司机节约的时间价值不直接当作码头现金收入。</p><h2>2. 付款与投产对照</h2><div class="scroll"><table><thead><tr><th>方案</th><th>付款/万元</th><th>能力与固定支出</th><th>工期与期末</th></tr></thead><tbody><tr><td>完整建设</td><td>t0：6000</td><td>30万TEU；350/年</td><td>t1施工影响300；第2年投产；t6残值1500</td></tr><tr><td>先建一期</td><td>t0：3200</td><td>15万TEU；200/年</td><td>t1影响180；第2年投产；t6残值800</td></tr><tr><td>追加二期</td><td>t1：3100</td><td>第3年起合计30；固定400/年</td><td>t2额外影响120；t6两期残值1700</td></tr><tr><td>观察后建</td><td>t1：6000</td><td>30万TEU；350/年；保留80%货源</td><td>t2影响300；第3年投产；t6残值1800</td></tr></tbody></table></div><h2>3. 计算时，先标明时点</h2><div class="formula">单笔现值 PVₜ=CFₜ/(1+r)ᵗ<br>项目净现值 NPV=Σₜ₌₀⁶ CFₜ/(1+r)ᵗ<br>t1追加价值：只比较“追加”与“保持”的后续现金差额</div><p>完整项目第2—6年五笔相等的经营现金，其t0折现因子和A=3.44616979。建设费、施工影响与残值分别保留。完整项目零NPV货源门槛约19.25万TEU/年；二期相对保持一期的追加门槛约26.20，均须核查适用区间与付款条件。</p><h2>4. 留下你自己的现金时间线</h2><div class="scroll"><table><thead><tr><th>时点</th><th>投资</th><th>施工影响</th><th>经营现金</th><th>净残值</th><th>净现金</th><th>t0现值</th></tr></thead><tbody>${Array.from({length:7},(_,i)=>'<tr><td>t'+i+'</td>'+Array.from({length:6},()=>'<td>&nbsp;</td>').join('')+'</tr>').join('')}</tbody></table></div><h2>5. 逐年模拟怎样进行</h2><ol><li>阅读共同参数，写下初始理由，确定完整建设、一期或等待。</li><li>播放第1年，观察施工与资金。年末才公布稳定需求状态。</li><li>按已公布信息决定保持、追加或启动，检查付款后储备。</li><li>继续播放第2—6年；压力情景到第4年才公布合同复核结果。</li><li>六年末在同一路径比较其他方案，写明是否修订初判。</li></ol><p>可暂停、继续或直接完成当前年；刷新回到最近已完成年度。可随时另开，已经保留的比较仍在。本机保存与下载不等于向教学平台提交成绩。</p><h2>6. 解释你的经营选择</h2><ul><li>哪个条件对建议最关键：需求、工期、成本、残值还是资金？</li><li>一期已经支付的费用，为何在追加差额中消去？</li><li>如果需求预测错误，是否意味着当时选择一定不合理？</li><li>在什么可观察条件下，你会追加、等待或停止新增投入？</li></ul><footer><p>真实案例与教学数字分别标明。${Object.values(PORT_INVESTMENT_SOURCES).filter(s=>s.url.startsWith('https')).map(s=>'<a href="'+s.url+'">'+escape(s.label)+'</a>').join(' · ')}</p></footer></main></body></html>`;
await mkdir('apps/teacher-web/public/handouts',{recursive:true});await writeFile('apps/teacher-web/public/handouts/port-investment-lesson18.html',handout);
