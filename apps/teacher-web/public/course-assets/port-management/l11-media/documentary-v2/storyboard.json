{
  "lesson": 11,
  "id": "l11-opening-v2",
  "title": "等待，发生在哪里",
  "subtitle": "一次港口效率追问",
  "duration": 180,
  "width": 1920,
  "height": 1200,
  "fps": 30,
  "format": "原创教学纪实短片 · 真实拍摄素材剪辑 · 中文合成旁白",
  "intent": "保留完整的作业动作，以动作接动作的剪辑观察货流。旁白跨越切点，档案只在必要时进入画面；不使用图表卡片或AI静帧撑时长。",
  "shots": [
    {
      "id": "cold",
      "from": 3,
      "to": 9.5,
      "narration": "这一箱离开船边以后，还要等多久？",
      "title": "一个吊箱动作"
    },
    {
      "id": "identity",
      "from": 10,
      "to": 20,
      "narration": "岸桥在动，车辆在走。繁忙的画面背后，交付可能仍在等待。",
      "title": "等待，发生在哪里"
    },
    {
      "id": "mpa",
      "from": 20,
      "to": 37.5,
      "narration": "二零二四年五月，新加坡。绕行好望角打乱班期，船舶集中到港。等待，从航线变化传到码头。",
      "title": "班期变化传到码头"
    },
    {
      "id": "volume",
      "from": 38,
      "to": 54,
      "narration": "官方说明记录，前四个月箱量同比增长百分之八点八。但总量之外，到港的节奏与单船作业量，也在改变。",
      "title": "原始说明中的证据"
    },
    {
      "id": "boundary",
      "from": 54,
      "to": 65.5,
      "narration": "这份说明同时明确，锚地并未拥挤。一个港口的压力，不能只凭一幅画面来判断。",
      "title": "画面与证据的边界"
    },
    {
      "id": "chain",
      "from": 66,
      "to": 80.5,
      "narration": "镜头转回作业。船边的一个吊箱动作，后面还接着运输、堆存和交付。每一次接续，都可能留下等待。",
      "title": "追踪货流的接续"
    },
    {
      "id": "constraint",
      "from": 81,
      "to": 96,
      "narration": "岸桥多卸一箱，车辆能否接走？堆场能否收下？如果下游不变，上游的提速，可能只是把队列推向下一个位置。",
      "title": "提速以后，谁来接续"
    },
    {
      "id": "clock",
      "from": 97,
      "to": 110.5,
      "narration": "要找到损失，先把时间端点记清。到港、开工、完工、离泊；再把货物离开堆场的时刻，接回同一条业务链。",
      "title": "把时间接回记录"
    },
    {
      "id": "unfinished",
      "from": 111,
      "to": 124,
      "narration": "平均值还可能遮住另一件事：那些仍未离港的船、仍未交付的箱，是否留在了报表里？",
      "title": "仍在等待的货物"
    },
    {
      "id": "experiment",
      "from": 124.5,
      "to": 138.5,
      "narration": "改善需要一次可复核的试验。同一个开局，同一批货物，同一个终点；只改变你声明要改变的条件。",
      "title": "一次能够复核的试验"
    },
    {
      "id": "takeover",
      "from": 139,
      "to": 154,
      "narration": "在接下来的现场接管中，先写一个能够被推翻的判断。增加司机会有用吗？你准备观察哪段队列、哪项交付记录？",
      "title": "接管教学现场"
    },
    {
      "id": "rival",
      "from": 155,
      "to": 168,
      "narration": "如果局部更快，最终交付却没有增加，你会保留原来的方案，还是重新寻找约束？",
      "title": "让结果改变判断"
    },
    {
      "id": "question",
      "from": 168.5,
      "to": 175,
      "narration": "你凭什么证明，等待真的减少了？",
      "title": "带入课堂的问题"
    }
  ],
