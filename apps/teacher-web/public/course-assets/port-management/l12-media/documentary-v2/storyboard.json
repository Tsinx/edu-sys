{
  "lesson": 12,
  "id": "l12-opening-v2",
  "title": "放行之前",
  "subtitle": "安全、证据与职业责任",
  "duration": 180,
  "width": 1920,
  "height": 1200,
  "fps": 30,
  "format": "原创教学纪实短片 · 真实拍摄素材剪辑 · 中文合成旁白",
  "intent": "以核验和交接动作进入职业责任，事故段只显示调查档案。现实作业与历史材料通过明确切点和短标识区分，不制造采访、事故同期声或违规人员指认。",
  "shots": [
    {
      "id": "cold",
      "from": 3,
      "to": 9.5,
      "narration": "放行之前，谁来确认这一箱货物可以继续向前？",
      "title": "放行之前的确认"
    },
    {
      "id": "identity",
      "from": 10,
      "to": 19.5,
      "narration": "一个签名，一次核对，一份交接。日常的动作，连着人的生命安全。",
      "title": "放行之前"
    },
    {
      "id": "life",
      "from": 20,
      "to": 35,
      "narration": "安全生产法强调人民至上、生命至上。这个要求，要落实在每次核验、每次暂停和每次有依据的决定中。",
      "title": "人的生命安全"
    },
    {
      "id": "archive",
      "from": 35.5,
      "to": 50.5,
      "narration": "二零一五年，天津港瑞海公司危险品仓库发生特别重大事故。回看官方调查报告，我们追问，风险为什么穿过了多道管理环节？",
      "title": "回看调查档案"
    },
    {
      "id": "barriers",
      "from": 51,
      "to": 65.5,
      "narration": "许可、库存、培训和监督，不能只看材料是否存在。还要追问：信息是否真实，边界是否清楚，失效时能不能被及时发现。",
      "title": "屏障如何发挥作用"
    },
    {
      "id": "digital",
      "from": 66,
      "to": 81,
      "narration": "今天的港口，还把调度和交付连接在数字系统上。设备仍能运转，并不说明身份、指令与回执仍然可信。",
      "title": "设备运转与信息可信"
    },
    {
      "id": "nagoya",
      "from": 81.5,
      "to": 96,
      "narration": "二零二三年，名古屋港码头系统发生安全事件，集装箱进出作业一度停止约三天。数字接口，也是一道运行屏障。",
      "title": "名古屋港2023"
    },
    {
      "id": "independent",
      "from": 97,
      "to": 109.5,
      "narration": "如果三个确认都抄自同一份记录，它们并不是三份独立证据。真正的复核，必须能够发现共同的错误。",
      "title": "独立核验"
    },
    {
      "id": "pause",
      "from": 110,
      "to": 124,
      "narration": "压力到来时，最难的决定，可能是让一段流程暂时停下，同时为后续恢复留下可信的记录与责任人。",
      "title": "暂停也是一种责任"
    },
    {
      "id": "restore",
      "from": 125,
      "to": 139,
      "narration": "恢复也有顺序。技术可用、业务对账、限定范围试运行；每一步，都要说清由谁核验、用什么证据通过。",
      "title": "有证据地恢复"
    },
    {
      "id": "takeover",
      "from": 140,
      "to": 155,
      "narration": "接下来的教学情境里，你将接管一个信息接口异常的班次。设备还能工作，记录却不能全信。请提交你愿意负责的处置方案。",
      "title": "接管教学班次"
    },
    {
      "id": "responsibility",
      "from": 156,
      "to": 168,
      "narration": "把生命安全放在首位，意味着在每一个具体决定里，守住边界，保留证据，也承担说明理由的责任。",
      "title": "把责任落实到决定"
    },
    {
      "id": "question",
      "from": 168.5,
      "to": 175,
      "narration": "放行之前，你还缺哪一份证据？",
      "title": "带入课堂的问题"
    }
  ],
