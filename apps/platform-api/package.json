    "@edu/course-content": "workspace:*",
    "@edu/port-simulation-core": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/static": "^8.3.0",
    "fastify": "5.10.0",
    "ws": "8.18.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/ws": "8.18.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
