# Shared fallback for the platform LLM, OpenAvatarChat cloud ASR and
# CosyVoice TTS. Keep the real value only in .env (Git-ignored).
DASHSCOPE_API_KEY=

# Platform-owned JSON-streaming assistant. These override the shared
# DashScope defaults when a different OpenAI-compatible provider is used.
# EDU_ASSISTANT_API_KEY=
EDU_ASSISTANT_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EDU_ASSISTANT_MODEL=qwen-plus

# OpenAvatarChat is now an ASR/TTS/LAM adapter; its LAM profile contains no LLM.
OPENAVATARCHAT_URL=http://127.0.0.1:8282
OPENAVATARCHAT_PUBLIC_URL=http://127.0.0.1:8282

# Teacher portal development services. Defaults are used when omitted.
EDU_API_HOST=127.0.0.1
EDU_API_PORT=4300
# EDU_DATA_FILE=D:\codes\edu-sys\.runtime\platform-api\state.json
