# Development configuration. For campus deployment use deploy/campus/campus.env.example
# and docs/campus-deployment.md; production never enables development identities.
# Shared fallback for the platform LLM, OpenAvatarChat cloud ASR and
# CosyVoice TTS. Keep the real value only in .env (Git-ignored).
DASHSCOPE_API_KEY=

# Platform-owned JSON-streaming assistant. These override the shared
# DashScope defaults when a different OpenAI-compatible provider is used.
# EDU_ASSISTANT_API_KEY=
EDU_ASSISTANT_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EDU_ASSISTANT_MODEL=qwen-plus

# Student self-study speech. The API key remains server-side. Create the
# fictional Lanzhou voice once with Qwen Voice Design, then store only its
# returned voice id here. Without a voice id, study answers remain text-only.
EDU_SELFSTUDY_ASR_MODEL=qwen3-asr-flash-2026-02-10
EDU_SELFSTUDY_TTS_MODEL=qwen3-tts-vd-realtime-2026-01-15
EDU_SELFSTUDY_TTS_VOICE_ID=
# 可选：声音设计接口；创建音色只通过服务端脚本执行
EDU_SELFSTUDY_VOICE_DESIGN_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/customization
# EDU_SELFSTUDY_SPEECH_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EDU_SELFSTUDY_TTS_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# 万相动作资产只在制作阶段调用；工作空间专属API根地址优先
EDU_WAN_API_BASE=https://dashscope.aliyuncs.com/api/v1
EDU_WAN_MODEL=wan2.7-r2v-2026-06-12

# OpenAvatarChat is now an ASR/TTS/LAM adapter; its LAM profile contains no LLM.
OPENAVATARCHAT_URL=http://127.0.0.1:8282
OPENAVATARCHAT_PUBLIC_URL=http://127.0.0.1:8282

# Teacher portal development services. Defaults are used when omitted.
EDU_API_HOST=127.0.0.1
EDU_API_PORT=4300
# EDU_DATA_FILE=D:\codes\edu-sys\.runtime\platform-api\state.json
