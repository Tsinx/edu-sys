NODE_ENV=production
EDU_DEPLOYMENT_PROFILE=campus
# 必须改成终端访问的 HTTPS origin；不要带末尾斜杠。
EDU_PUBLIC_ORIGIN=https://classroom.example.edu
EDU_API_HOST=127.0.0.1
EDU_API_PORT=4300
EDU_DATA_FILE=./data/state.json
EDU_PORT_SIMULATION_DB=./data/port-simulation.sqlite
EDU_STATIC_ROOT=./web
EDU_ALLOW_DEVELOPMENT_IDENTITY=false
EDU_AI_CONCURRENCY=6
EDU_AI_QUEUE=30
EDU_AI_DAILY_REQUESTS=100
EDU_AI_TIMEOUT_MS=120000
EDU_ASSISTANT_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EDU_ASSISTANT_MODEL=qwen-plus
DASHSCOPE_API_KEY=
# 可选，独立的语言模型服务商密钥。
# EDU_ASSISTANT_API_KEY=
EDU_SELFSTUDY_ASR_MODEL=qwen-audio-3.1-asr-flash
EDU_SELFSTUDY_TTS_MODEL=qwen-audio-3.1-tts-flash
EDU_SELFSTUDY_TTS_PRESET_MODEL=qwen-audio-3.1-tts-flash
# 3.1 ASR/TTS derive workspace endpoints from EDU_REALTIME_URL, or set these:
# EDU_SELFSTUDY_ASR_NATIVE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# EDU_SELFSTUDY_TTS_TASK_WS_URL=wss://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# A legacy custom voice ID cannot be reused across models.
EDU_SELFSTUDY_TTS_VOICE_ID=longanhuan_v3.1
# Use the same workspace and region for realtime, native ASR and task-based TTS.
EDU_REALTIME_ENABLED=false
EDU_REALTIME_URL=
EDU_REALTIME_MODEL=qwen-audio-3.1-realtime-plus
EDU_REALTIME_VOICE=longanqian_v3.1
# EDU_REALTIME_API_KEY=
