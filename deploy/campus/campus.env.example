NODE_ENV=production
EDU_DEPLOYMENT_PROFILE=campus
# 必须改成终端访问的 HTTPS origin；不要带末尾斜杠。
EDU_PUBLIC_ORIGIN=https://classroom.example.edu
EDU_API_HOST=127.0.0.1
EDU_API_PORT=4300
EDU_DATA_FILE=./data/state.json
EDU_PORT_SIMULATION_DB=./data/port-simulation.sqlite
EDU_STATIC_ROOT=./web
EDU_ALLOW_DEVELOPMENT_IDENTITY=false
EDU_AI_CONCURRENCY=6
EDU_AI_QUEUE=30
EDU_AI_DAILY_REQUESTS=100
EDU_AI_TIMEOUT_MS=120000
EDU_ASSISTANT_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EDU_ASSISTANT_MODEL=qwen-plus
DASHSCOPE_API_KEY=
# 可选，独立的语言模型服务商密钥。
# EDU_ASSISTANT_API_KEY=
EDU_SELFSTUDY_ASR_MODEL=qwen3-asr-flash-2026-02-10
EDU_SELFSTUDY_TTS_MODEL=qwen3-tts-vd-realtime-2026-01-15
EDU_SELFSTUDY_TTS_VOICE_ID=
